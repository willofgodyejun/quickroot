KAKAO_REST_API_KEY=여기에_카카오_REST_API_키
NAVER_CLIENT_ID=여기에_네이버_Client_ID
NAVER_CLIENT_SECRET=여기에_네이버_Client_Secret
TMAP_APP_KEY=여기에_티맵_appKey
# 지도 표시용(선택): 카카오 JavaScript 키(앱 키 → JavaScript 키, 사이트 도메인에 http://localhost:3000 등록)
# KAKAO_JS_KEY=
# 티맵 지도용 appKey를 경로 안내 키와 따로 쓸 때만
# TMAP_MAP_APP_KEY=
# 선택: 오피넷 API 키(opinet.co.kr 무료 발급). 없으면 코드에 넣어 둔 전국 평균 기본값을 씁니다
# OPINET_API_KEY=
PORT=3000
