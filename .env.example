KAKAO_REST_API_KEY=여기에_카카오_REST_API_키
NAVER_CLIENT_ID=여기에_네이버_Client_ID
NAVER_CLIENT_SECRET=여기에_네이버_Client_Secret
TMAP_APP_KEY=여기에_티맵_appKey
# 지도 표시용(선택): 카카오 JavaScript 키(앱 키 → JavaScript 키, 사이트 도메인에 http://localhost:3000 등록)
# KAKAO_JS_KEY=
# 티맵 지도용 appKey를 경로 안내 키와 따로 쓸 때만
# TMAP_MAP_APP_KEY=
# 선택: 오피넷 API 키(opinet.co.kr 무료 발급). 없으면 코드에 넣어 둔 전국 평균 기본값을 씁니다
# OPINET_API_KEY=
PORT=3000

# ---- 주소로 공유할 때 (README의 '공유하기' 참고) ----
# 기본은 내 컴퓨터에서만 접속(127.0.0.1). 배포 서비스에서는 HOST=0.0.0.0 으로 바꾸세요
# HOST=127.0.0.1
# 접속 비밀번호: 설정하면 비밀번호만 입력하는 로그인 화면이 나와요. 공유할 땐 꼭 설정하세요
# APP_PASSWORD=
# 프록시(Render, Railway 등) 뒤에서 실제 접속자 IP로 제한하려면 1
# TRUST_PROXY=1
# 하루 호출 상한 (한국 시간 자정에 초기화, 서버를 다시 켜면 0으로 돌아가요)
# DAILY_LIMIT_ROUTE=1500   # 앱별 길찾기 호출 (카카오 무료 쿼터는 하루 10,000건)
# DAILY_LIMIT_SEARCH=3000  # 장소 검색·자동완성·좌표→주소
# RATE_LIMIT_PER_MIN=120   # 접속자 IP당 분당 API 요청 수
